# APP_URL is retained for hosted-environment compatibility; the application does not currently read it.
APP_URL="MY_APP_URL"

# Set a long, stable random secret in any persistent deployment.
# If omitted, a new random secret is generated on every server start and sessions expire.
SESSION_SECRET=

# Optional fixed admin passcode. If set, admin login uses this value and first-run claim is disabled.
ADMIN_PASSCODE=

# Required for first-run admin claiming when ADMIN_PASSCODE is empty.
# Generate a strong random value and deliver it to the trusted operator out of band.
# After an admin passcode is claimed, this token can be removed from the environment.
ADMIN_BOOTSTRAP_TOKEN=

# Persistent directory for local JSON storage. Defaults to .data under the working directory.
DATA_DIR=
